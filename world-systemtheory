<body>

    <!-- ─── HEADER ─────────────────────────────────────────────────────── -->
    <header class="futuristic-header">
        <div class="brand-future">
            <div class="logo-hologram">🌐</div>
            <div>
                <div class="brand-name-future">GCIS ENCYCLOPEDIA</div>
                <div class="brand-sub-future">▸ World-Systems Theory · Dynamic Synthesis</div>
            </div>
        </div>
        <div class="header-right-future">
            <a href="#" class="hbtn-future" onclick="window.location.reload();">↻ Refresh</a>
            <a href="https://en.wikipedia.org/wiki/World-systems_theory" target="_blank" class="hbtn-future primary">📖 Source</a>
        </div>
    </header>

    <!-- ─── MAIN CONTENT ───────────────────────────────────────────────── -->
    <div class="app">
        <div class="encyclopedia-content" id="content">
            <div class="loader-container">
                <div class="loader-ring"></div>
                <div class="loader-h">Assembling Encyclopedia</div>
                <div class="loader-sub">Fetching &amp; synthesizing from 5 Wikipedia sources …</div>
            </div>
        </div>
    </div>

    <script>
        (function() {
            "use strict";

            // ─── CONFIG ──────────────────────────────────────────────────
            const WIKI_API_BASE = 'https://en.wikipedia.org/w/api.php';
            const PAGES = [
                'World-systems theory',
                'Periphery countries',
                'Core countries',
                'Semi-periphery countries',
                'Capitalism'
            ];

            // ─── FETCH EXTRACT (plain text) ────────────────────────────
            async function fetchExtract(title) {
                const url = new URL(WIKI_API_BASE);
                url.searchParams.set('action', 'query');
                url.searchParams.set('format', 'json');
                url.searchParams.set('origin', '*');
                url.searchParams.set('prop', 'extracts');
                url.searchParams.set('explaintext', '1');
                url.searchParams.set('exintro', '0');
                url.searchParams.set('exlimit', '1');
                url.searchParams.set('titles', title);

                const response = await fetch(url.toString());
                if (!response.ok) throw new Error(`HTTP ${response.status} for ${title}`);
                const data = await response.json();
                const pages = data.query?.pages;
                if (!pages) throw new Error(`No pages returned for ${title}`);
                const pageId = Object.keys(pages)[0];
                if (pageId === '-1') throw new Error(`Page "${title}" not found.`);
                return pages[pageId]?.extract || '';
            }

            // ─── HELPERS ─────────────────────────────────────────────────
            function extractSection(text, startHeading, endHeading) {
                if (!text || !startHeading) return null;
                const lines = text.split(/\n+/);
                let startIdx = -1;
                let endIdx = lines.length;
                const startLower = startHeading.toLowerCase();
                const endLower = endHeading ? endHeading.toLowerCase() : null;

                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i].trim();
                    if (startIdx === -1) {
                        if (line.toLowerCase().includes(startLower) || line.toLowerCase() === startLower) {
                            startIdx = i + 1;
                        }
                    } else if (endLower && line.toLowerCase().includes(endLower)) {
                        endIdx = i;
                        break;
                    }
                }

                if (startIdx === -1 || startIdx >= endIdx) return null;
                let section = lines.slice(startIdx, endIdx).join(' ').trim();
                section = section.replace(/^[=#]+\s*.*?\s*[=#]+/g, '').trim();
                return section || null;
            }

            function extractIntro(text) {
                if (!text) return null;
                const lines = text.split(/\n+/);
                let intro = '';
                let count = 0;
                for (const line of lines) {
                    if (line.trim().length === 0) continue;
                    if (count >= 2) break;
                    if (/^=+/.test(line.trim())) continue;
                    intro += line.trim() + ' ';
                    count++;
                }
                return intro.trim() || null;
            }

            function extractListItems(text, sectionTitle) {
                if (!text) return [];
                const section = extractSection(text, sectionTitle, '');
                if (!section) return [];
                const items = [];
                const lines = section.split(/\n+/);
                for (const line of lines) {
                    const trimmed = line.trim();
                    if (/^[\*\-•]/.test(trimmed)) {
                        items.push(trimmed.replace(/^[\*\-•]\s*/, '').trim());
                    } else if (/^\d+\./.test(trimmed)) {
                        items.push(trimmed.replace(/^\d+\.\s*/, '').trim());
                    }
                }
                return items.slice(0, 20);
            }

            // ─── BUILD ENCYCLOPEDIA ─────────────────────────────────────
            function buildEncyclopedia(extracts) {
                const wst = extracts['World-systems theory'] || '';
                const core = extracts['Core countries'] || '';
                const periphery = extracts['Periphery countries'] || '';
                const semi = extracts['Semi-periphery countries'] || '';
                const capitalism = extracts['Capitalism'] || '';

                let html = '';

                // ── Title ──
                html += `<h1>World-Systems Theory</h1>`;

                // ── Intro from WST ──
                const wstLines = wst.split(/\n+/);
                let introText = '';
                let paragraphCount = 0;
                for (const line of wstLines) {
                    if (line.trim().length === 0) continue;
                    if (paragraphCount >= 3) break;
                    introText += `<p>${line.trim()}</p>`;
                    paragraphCount++;
                }
                html += introText;

                // ── Background ──
                const bg = extractSection(wst, 'Background', 'Origins');
                if (bg) {
                    html += `<h2>Background</h2><p>${bg}</p>`;
                }

                // ── Origins ──
                const origins = extractSection(wst, 'Origins', 'Characteristics');
                if (origins) {
                    html += `<h2>Origins and Intellectual Influences</h2><p>${origins}</p>`;
                }

                // ── Dependency Theory ──
                const dep = extractSection(wst, 'Dependency theory', 'Importance');
                if (dep) {
                    html += `<h2>Dependency Theory and Its Influence</h2><p>${dep}</p>`;
                }

                // ── Tripartite Structure ──
                html += `<h2>The Tripartite Structure: Core, Periphery, and Semi-Periphery</h2>`;
                html += `<p>World-systems theory divides the global economy into three broad zones: <strong>core</strong>, <strong>periphery</strong>, and <strong>semi-periphery</strong>. These categories reflect a country's position in the international division of labour and its relative power, wealth, and level of industrialisation.</p>`;

                // ── Core ──
                const coreIntro = extractIntro(core);
                html += `<h3>Core Countries</h3>`;
                html += `<p>${coreIntro || 'Core countries are the industrialised, wealthy, and powerful states that dominate the world economy. They have strong institutions, advanced technology, and command the most profitable activities.'}</p>`;
                const coreChar = extractSection(core, 'Definition', 'Throughout history');
                if (coreChar) html += `<p>${coreChar}</p>`;
                const coreList = extractListItems(core, 'Examples');
                if (coreList.length > 0) {
                    html += `<h4>Examples of Core Countries</h4><ul>`;
                    coreList.forEach(item => html += `<li>${item}</li>`);
                    html += `</ul>`;
                }

                // ── Periphery ──
                const periIntro = extractIntro(periphery);
                html += `<h3>Periphery Countries</h3>`;
                html += `<p>${periIntro || 'Periphery countries are less developed, have weak state institutions, and are dependent on—and often exploited by—core countries. They typically export raw materials and agricultural goods.'}</p>`;
                const periChar = extractSection(periphery, 'Background', 'Formation');
                if (periChar) html += `<p>${periChar}</p>`;
                const periWays = extractSection(periphery, 'Ways to improve', 'Adaptation');
                if (periWays) {
                    html += `<h4>Paths to Advancement</h4><p>${periWays}</p>`;
                }

                // ── Semi-periphery ──
                const semiIntro = extractIntro(semi);
                html += `<h3>Semi-Periphery Countries</h3>`;
                html += `<p>${semiIntro || 'Semi-periphery countries are industrialising, middle-income states that share characteristics of both core and periphery. They mediate between the core and the periphery.'}</p>`;
                const semiChar = extractSection(semi, 'Sociological theory', 'History and development');
                if (semiChar) html += `<p>${semiChar}</p>`;
                const semiList = extractListItems(semi, 'Semi-periphery countries');
                if (semiList.length > 0) {
                    html += `<h4>Examples of Semi-Periphery Countries</h4><ul>`;
                    semiList.forEach(item => html += `<li>${item}</li>`);
                    html += `</ul>`;
                }

                // ── Capitalism ──
                html += `<h2>Capitalism: The Economic Foundation</h2>`;
                const capIntro = extractIntro(capitalism);
                html += `<p>${capIntro || 'Capitalism is an economic system based on private ownership of the means of production and their operation for profit. It is characterised by capital accumulation, competitive markets, wage labour, and innovation.'}</p>`;
                const capHist = extractSection(capitalism, 'History', 'Characteristics');
                if (capHist) {
                    html += `<h3>Historical Development</h3><p>${capHist}</p>`;
                }
                const capFeatures = extractSection(capitalism, 'Characteristics', 'Supply and demand');
                if (capFeatures) {
                    html += `<h3>Core Features</h3><p>${capFeatures}</p>`;
                }
                const capSupply = extractSection(capitalism, 'Supply and demand', '');
                if (capSupply) {
                    html += `<h3>Supply and Demand</h3><p>${capSupply}</p>`;
                }

                // ── Modern World-System ──
                html += `<h2>The Modern World-System in Perspective</h2>`;
                const interpret = extractSection(wst, 'The interpretation of world history', '');
                if (interpret) {
                    html += `<p>${interpret}</p>`;
                } else {
                    html += `<p>World-systems analysis views the capitalist world-economy as a historically specific system that emerged in the "long" 16th century. It has since expanded to encompass the entire globe, creating an inter-regional division of labour that perpetuates inequality. The system is dynamic, with cyclical rhythms and secular trends, and it is currently in a period of transition whose outcome is uncertain. Understanding the interlocking roles of core, periphery, and semi-periphery—alongside the logic of capital accumulation—is essential for grasping the trajectory of modern global history.</p>`;
                }

                // ── Footer ──
                html += `<hr />`;
                html += `<div class="footer-note">`;
                html += `This article is a dynamic synthesis of content from: `;
                html += PAGES.map(p =>
                    `<a href="https://en.wikipedia.org/wiki/${p.replace(/ /g, '_')}" target="_blank">${p}</a>`
                ).join(', ');
                html += `. Data fetched via Wikipedia API and combined in real-time.`;
                html += `</div>`;

                return html;
            }

            // ─── MAIN ────────────────────────────────────────────────────
            async function main() {
                const container = document.getElementById('content');

                try {
                    const fetchPromises = PAGES.map(async (title) => {
                        try {
                            const extract = await fetchExtract(title);
                            return { title, extract };
                        } catch (err) {
                            console.warn(`Failed to fetch "${title}":`, err);
                            return { title, extract: '' };
                        }
                    });

                    const results = await Promise.all(fetchPromises);
                    const extracts = {};
                    for (const r of results) extracts[r.title] = r.extract;

                    const totalChars = Object.values(extracts).reduce((sum, e) => sum + e.length, 0);
                    if (totalChars < 200) {
                        container.innerHTML = `
                            <div style="text-align:center; padding:3rem 1rem; color:#ff375f;">
                                <h2 style="color:#ff375f;">⚠️ Unable to retrieve article content</h2>
                                <p style="color:var(--text-secondary);">Wikipedia may be rate-limiting or the pages are temporarily unavailable.</p>
                                <p style="font-family:var(--font-mono); font-size:0.8rem; color:var(--text-dim);">Please try again later.</p>
                            </div>
                        `;
                        return;
                    }

                    const htmlContent = buildEncyclopedia(extracts);
                    container.innerHTML = htmlContent;

                } catch (err) {
                    container.innerHTML = `
                        <div style="text-align:center; padding:3rem 1rem; color:#ff375f;">
                            <h2 style="color:#ff375f;">⚠️ Error Loading Content</h2>
                            <p style="color:var(--text-secondary);">${err.message || 'An unknown error occurred.'}</p>
                        </div>
                    `;
                    console.error(err);
                }
            }

            // ─── BOOT ─────────────────────────────────────────────────────
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', main);
            } else {
                main();
            }

        })();
    </script>

</body>
</html>
