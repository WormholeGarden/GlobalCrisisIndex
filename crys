<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>CRYS · Crisis Intelligence</title>
<style>
/* ── RESET & BASE ──────────────────────────────────────────────────────────── */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
:root {
  --bg0:      #020b17;
  --bg1:      #071221;
  --bg2:      #0b1a2e;
  --bg3:      #0f2040;
  --border:   rgba(66,153,225,0.15);
  --border2:  rgba(66,153,225,0.28);
  --cyan:     #4dabf7;
  --cyan2:    #74c0fc;
  --text:     #e8f4ff;
  --text2:    #8eb8e0;
  --text3:    #4a6a8a;
  --red:      #ff6b6b;
  --orange:   #ffa94d;
  --yellow:   #ffe066;
  --green:    #69db7c;
  --blue:     #74c0fc;
  --purple:   #cc5de8;
  --r:        14px;
  --r-sm:     8px;
}
html, body { height:100%; overflow:hidden; background:var(--bg0); color:var(--text); font-family:system-ui,-apple-system,'Segoe UI','Inter',sans-serif; font-size:15px; line-height:1.5; }
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--bg3); border-radius:99px; }

/* ── LAYOUT ────────────────────────────────────────────────────────────────── */
.shell { display:flex; flex-direction:column; height:100vh; }

/* ── HEADER ────────────────────────────────────────────────────────────────── */
.header {
  display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem;
  padding:.75rem 1.5rem; border-bottom:1px solid var(--border);
  background:rgba(2,11,23,.92); backdrop-filter:blur(20px); z-index:20; flex-shrink:0;
}
.brand { display:flex; align-items:baseline; gap:.6rem; }
.brand h1 {
  font-size:1.55rem; font-weight:800; letter-spacing:-.02em;
  background:linear-gradient(135deg,#fff 30%,var(--cyan)); -webkit-background-clip:text; background-clip:text; color:transparent;
}
.brand-tag {
  font-size:.68rem; font-family:monospace; letter-spacing:.08em; text-transform:uppercase;
  background:var(--bg3); color:var(--cyan2); padding:.18rem .55rem; border-radius:99px; border:1px solid var(--border2);
}
.header-right { display:flex; align-items:center; gap:.75rem; }
.live-dot-wrap { display:flex; align-items:center; gap:.4rem; font-size:.7rem; color:var(--text3); font-family:monospace; letter-spacing:.05em; }
.live-dot { width:6px; height:6px; border-radius:50%; background:#51cf66; box-shadow:0 0 6px #51cf66; animation:blink 2s ease-in-out infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.35} }
.source-pills { display:flex; gap:.4rem; flex-wrap:wrap; }
.pill { font-size:.62rem; font-family:monospace; background:var(--bg2); border:1px solid var(--border); color:var(--text3); padding:.18rem .55rem; border-radius:99px; }

/* ── CHAT ──────────────────────────────────────────────────────────────────── */
.chat { flex:1; overflow-y:auto; padding:1.5rem; scroll-behavior:smooth; }
.messages { max-width:860px; margin:0 auto; display:flex; flex-direction:column; gap:1.25rem; padding-bottom:.5rem; }

/* ── MESSAGE BUBBLES ───────────────────────────────────────────────────────── */
.msg { display:flex; flex-direction:column; gap:.3rem; max-width:88%; animation:rise .18s ease-out; }
@keyframes rise { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
.msg-user  { align-self:flex-end; }
.msg-crys  { align-self:flex-start; }
.bubble {
  padding:.8rem 1.15rem; border-radius:1.4rem; word-break:break-word;
  font-size:.9rem; line-height:1.55;
}
.msg-user  .bubble { background:#1a3a60; border-bottom-right-radius:.3rem; color:#fff; }
.msg-crys  .bubble { background:var(--bg2); border:1px solid var(--border); border-bottom-left-radius:.3rem; color:var(--text); }
.msg-meta  { font-size:.65rem; color:var(--text3); font-family:monospace; padding:0 .4rem; }

/* ── RICH CONTENT INSIDE BUBBLES ───────────────────────────────────────────── */
.bubble strong { font-weight:700; color:var(--cyan2); }
.bubble em     { font-style:normal; color:var(--text2); }
.bubble a      { color:var(--cyan); text-decoration:none; }
.bubble a:hover{ text-decoration:underline; }

/* Score badge */
.score-hero {
  display:inline-flex; align-items:baseline; gap:.4rem;
  font-size:1.8rem; font-weight:900; letter-spacing:-.03em; line-height:1;
}
.score-hero .denom { font-size:1rem; font-weight:400; color:var(--text3); }

/* Severity pill */
.sev {
  display:inline-block; font-size:.65rem; font-weight:700; letter-spacing:.08em;
  padding:.22rem .6rem; border-radius:99px; font-family:monospace;
}
.sev-CATASTROPHIC { background:rgba(255,107,107,.15); color:#ff6b6b; border:1px solid rgba(255,107,107,.3); }
.sev-CRITICAL     { background:rgba(255,169,77,.15);  color:#ffa94d; border:1px solid rgba(255,169,77,.3); }
.sev-HIGH         { background:rgba(255,224,102,.12); color:#ffe066; border:1px solid rgba(255,224,102,.3); }
.sev-ELEVATED     { background:rgba(105,219,124,.1);  color:#69db7c; border:1px solid rgba(105,219,124,.25); }
.sev-MODERATE     { background:rgba(116,192,252,.1);  color:#74c0fc; border:1px solid rgba(116,192,252,.25); }

/* Rank chip */
.rank-chip {
  display:inline-flex; align-items:center; gap:.3rem;
  font-size:.68rem; font-family:monospace; color:var(--text3);
}

/* Dimension bars */
.dims { display:flex; flex-direction:column; gap:.45rem; margin:.35rem 0; }
.dim-row { display:flex; align-items:center; gap:.6rem; }
.dim-label { font-size:.72rem; color:var(--text2); width:90px; flex-shrink:0; font-family:monospace; letter-spacing:.02em; text-transform:uppercase; }
.dim-track { flex:1; height:5px; background:rgba(255,255,255,.06); border-radius:99px; overflow:hidden; }
.dim-fill  { height:100%; border-radius:99px; transition:width .6s ease; }
.dim-val   { font-size:.72rem; font-family:monospace; width:28px; text-align:right; color:var(--text2); flex-shrink:0; }
.dim-ctx   { font-size:.65rem; color:var(--text3); flex:0 0 auto; max-width:180px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

/* Evidence items */
.evidence { display:flex; flex-direction:column; gap:.3rem; margin:.35rem 0; }
.ev-item { display:flex; align-items:flex-start; gap:.5rem; font-size:.8rem; }
.ev-icon { flex-shrink:0; font-size:.85rem; margin-top:.05rem; }
.ev-text { color:var(--text2); line-height:1.4; }
.ev-source { font-size:.62rem; color:var(--text3); font-family:monospace; }

/* Section label */
.section-label {
  font-size:.62rem; font-family:monospace; letter-spacing:.12em; text-transform:uppercase;
  color:var(--text3); margin-bottom:.4rem; display:block; padding-top:.6rem;
}

/* Comparison table */
.comp-table { width:100%; border-collapse:collapse; font-size:.8rem; margin:.4rem 0; }
.comp-table th { font-size:.65rem; font-family:monospace; letter-spacing:.08em; color:var(--text3); text-align:left; padding:.3rem .5rem; border-bottom:1px solid var(--border); }
.comp-table td { padding:.3rem .5rem; border-bottom:1px solid rgba(66,153,225,.06); color:var(--text2); vertical-align:top; }
.comp-table td.winner { color:var(--cyan2); font-weight:700; }
.comp-table td.loser  { color:var(--text3); }

/* Trend spark */
.trend-row { display:flex; align-items:center; gap:.6rem; font-size:.8rem; margin:.2rem 0; }
.trend-dir { font-size:.72rem; font-family:monospace; }
.trend-up   { color:var(--red); }
.trend-down { color:var(--green); }
.trend-flat { color:var(--text3); }

/* Forecast */
.forecast-row { display:flex; align-items:center; gap:.6rem; font-size:.78rem; color:var(--text2); }

/* Recommendation box */
.rec-box {
  display:flex; align-items:flex-start; gap:.6rem;
  background:rgba(255,255,255,.03); border:1px solid var(--border);
  border-radius:var(--r-sm); padding:.55rem .75rem; margin:.4rem 0; font-size:.82rem;
}
.rec-IMMEDIATE { border-color:rgba(255,107,107,.35); background:rgba(255,107,107,.05); }
.rec-URGENT    { border-color:rgba(255,169,77,.3);  background:rgba(255,169,77,.04); }
.rec-HIGH      { border-color:rgba(255,224,102,.25);background:rgba(255,224,102,.04); }
.rec-MONITOR   { border-color:rgba(105,219,124,.2); background:rgba(105,219,124,.03); }
.rec-WATCH     { border-color:var(--border); }
.rec-icon { font-size:.95rem; flex-shrink:0; margin-top:.05rem; }
.rec-text { color:var(--text2); line-height:1.45; }

/* Ranking list */
.rank-list { display:flex; flex-direction:column; gap:.3rem; margin:.4rem 0; }
.rank-item {
  display:flex; align-items:center; gap:.6rem;
  padding:.4rem .6rem; border-radius:var(--r-sm); background:rgba(255,255,255,.02);
  border:1px solid rgba(66,153,225,.08); font-size:.82rem; cursor:pointer;
  transition:background .15s, border-color .15s;
}
.rank-item:hover { background:rgba(66,153,225,.07); border-color:var(--border2); }
.rank-num  { font-family:monospace; font-size:.68rem; color:var(--text3); width:22px; flex-shrink:0; }
.rank-flag { font-size:1rem; flex-shrink:0; }
.rank-name { flex:1; font-weight:500; }
.rank-score{ font-family:monospace; font-size:.78rem; font-weight:700; flex-shrink:0; }
.rank-bar  { width:60px; height:3px; background:rgba(255,255,255,.06); border-radius:99px; overflow:hidden; flex-shrink:0; }
.rank-fill { height:100%; border-radius:99px; }

/* Audit */
.audit-list { display:flex; flex-direction:column; gap:.3rem; margin:.35rem 0; }
.audit-item { font-size:.75rem; color:var(--text2); display:flex; align-items:flex-start; gap:.5rem; }
.audit-src  { font-family:monospace; font-size:.65rem; color:var(--cyan); background:rgba(77,171,247,.1); padding:.1rem .4rem; border-radius:3px; flex-shrink:0; }
.audit-delta{ font-family:monospace; font-size:.68rem; color:var(--green); flex-shrink:0; }

/* Spillover */
.spill-row { display:flex; align-items:center; gap:.5rem; font-size:.78rem; color:var(--text2); }

/* Typing */
.typing { display:flex; gap:5px; align-items:center; padding:.55rem .9rem; background:var(--bg2); border:1px solid var(--border); border-radius:2rem; width:fit-content; }
.typing span { width:7px; height:7px; background:var(--cyan); border-radius:50%; animation:tp 1.1s ease-in-out infinite; }
.typing span:nth-child(2){animation-delay:.14s}
.typing span:nth-child(3){animation-delay:.28s}
@keyframes tp { 0%,100%{opacity:.3;transform:scale(.8)} 50%{opacity:1;transform:scale(1.2)} }

/* Welcome */
.welcome { text-align:center; padding:2.5rem 1rem; }
.welcome-globe { font-size:3rem; margin-bottom:.75rem; opacity:.6; animation:float 3s ease-in-out infinite; }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }
.welcome h2 { font-size:1.25rem; font-weight:700; margin-bottom:.4rem; }
.welcome p  { font-size:.82rem; color:var(--text3); line-height:1.7; max-width:420px; margin:0 auto; }

/* ── INPUT AREA ────────────────────────────────────────────────────────────── */
.input-area {
  flex-shrink:0; background:rgba(7,18,33,.97); border-top:1px solid var(--border);
  padding:.9rem 1.5rem 1.25rem; backdrop-filter:blur(12px);
}
.input-row {
  max-width:860px; margin:0 auto; display:flex; gap:.6rem;
  background:var(--bg2); border:1px solid var(--border2); border-radius:3rem;
  padding:.3rem .3rem .3rem .3rem; transition:border-color .2s, box-shadow .2s;
}
.input-row:focus-within { border-color:var(--cyan); box-shadow:0 0 0 2px rgba(77,171,247,.15); }
.input-row input {
  flex:1; background:transparent; border:none; outline:none;
  padding:.75rem 1.1rem; font-size:.95rem; color:var(--text); font-family:inherit;
}
.input-row input::placeholder { color:var(--text3); }
.send-btn {
  background:var(--cyan); color:#020b17; border:none; border-radius:2.5rem;
  padding:.5rem 1.3rem; font-weight:700; font-size:.88rem; cursor:pointer; flex-shrink:0;
  transition:background .15s, transform .1s; display:flex; align-items:center; gap:.35rem;
}
.send-btn:hover { background:var(--cyan2); }
.send-btn:active { transform:scale(.97); }

/* Chips */
.chips-row {
  max-width:860px; margin:.65rem auto 0; display:flex; flex-wrap:wrap; gap:.4rem;
}
.chip {
  font-size:.7rem; background:var(--bg2); border:1px solid var(--border);
  color:var(--text2); padding:.28rem .85rem; border-radius:2rem; cursor:pointer;
  transition:all .15s; white-space:nowrap; user-select:none;
}
.chip:hover { background:var(--bg3); border-color:var(--border2); color:var(--text); }

/* ── MISC ──────────────────────────────────────────────────────────────────── */
.divider { height:1px; background:var(--border); margin:.6rem 0; opacity:.5; }
.footer-note { text-align:center; font-size:.62rem; color:var(--text3); font-family:monospace; margin-top:.6rem; letter-spacing:.04em; }

/* ── MOBILE ────────────────────────────────────────────────────────────────── */
@media(max-width:600px){
  .header { padding:.6rem 1rem; }
  .source-pills { display:none; }
  .chat { padding:1rem; }
  .msg { max-width:95%; }
  .bubble { font-size:.85rem; padding:.7rem 1rem; }
  .input-area { padding:.7rem 1rem 1rem; }
  .chips-row { display:none; }
  .dim-ctx { display:none; }
  .comp-table { font-size:.72rem; }
}
</style>
