<body>
<div class="shell">

<!-- ── HEADER ──────────────────────────────────────────────────────────────── -->
<header class="header">
  <div class="brand">
    <h1>CRYS</h1>
    <span class="brand-tag">crisis intelligence</span>
  </div>
  <div class="header-right">
    <div class="live-dot-wrap">
      <div class="live-dot"></div>
      LIVE
    </div>
    <div class="source-pills">
      <span class="pill">USGS</span>
      <span class="pill">IPC</span>
      <span class="pill">WHO</span>
      <span class="pill">UNHCR</span>
      <span class="pill">Open-Meteo</span>
    </div>
  </div>
</header>

<!-- ── CHAT ────────────────────────────────────────────────────────────────── -->
<div class="chat" id="chat">
  <div class="messages" id="msgs">
    <div class="welcome">
      <div class="welcome-globe">🌐</div>
      <h2>Ask CRYS anything about crisis.</h2>
      <p>Type a country, a question, or a comparison.<br>
        <em>CRYS does not guess. The data shows.</em></p>
    </div>
  </div>
</div>

<!-- ── INPUT ────────────────────────────────────────────────────────────────── -->
<div class="input-area">
  <div class="input-row">
    <input id="inp" type="text" placeholder="How bad is Somalia? · Compare Sudan and Yemen · Top 5 crises · Africa ranked…" autocomplete="off" spellcheck="false">
    <button class="send-btn" id="sendBtn">
      <span>Ask</span>
      <span style="font-size:.8rem;">↵</span>
    </button>
  </div>
  <div class="chips-row" id="chips">
    <div class="chip" data-q="Somalia">🇸🇴 Somalia</div>
    <div class="chip" data-q="Sudan">🇸🇩 Sudan</div>
    <div class="chip" data-q="Yemen">🇾🇪 Yemen</div>
    <div class="chip" data-q="Palestine">🇵🇸 Palestine</div>
    <div class="chip" data-q="Afghanistan">🇦🇫 Afghanistan</div>
    <div class="chip" data-q="top 5">🔝 Top 5</div>
    <div class="chip" data-q="compare Somalia and Yemen">📊 Somalia vs Yemen</div>
    <div class="chip" data-q="Africa ranked">🌍 Africa</div>
    <div class="chip" data-q="what is improving">📉 Improving</div>
    <div class="chip" data-q="what is escalating">📈 Escalating</div>
    <div class="chip" data-q="worst food crisis">🍚 Food crisis</div>
    <div class="chip" data-q="worst displacement">🚶 Displacement</div>
  </div>
  <div class="footer-note">Scores refresh every 5 min · USGS · IPC · WHO · UNHCR · Open-Meteo</div>
</div>

</div><!-- .shell -->

<script>
"use strict";

// ── CONFIG ──────────────────────────────────────────────────────────────────
const API = "https://www.globalcrisisindex.com/api/top-story";

// ── SCORE → COLOR ────────────────────────────────────────────────────────────
function scoreColor(s) {
  if (s >= 85) return "#ff6b6b";
  if (s >= 75) return "#ffa94d";
  if (s >= 60) return "#ffe066";
  if (s >= 40) return "#69db7c";
  return "#74c0fc";
}

function dimColor(v) {
  if (v >= 80) return "#ff6b6b";
  if (v >= 65) return "#ffa94d";
  if (v >= 50) return "#ffe066";
  if (v >= 35) return "#74c0fc";
  return "#4a6a8a";
}

// ── SAFE FETCH ────────────────────────────────────────────────────────────────
async function apiFetch(params) {
  const url = new URL(API);
  for (const [k, v] of Object.entries(params)) {
    if (v !== null && v !== undefined) url.searchParams.set(k, v);
  }
  const res = await fetch(url.toString());
  if (!res.ok) throw new Error(`API error ${res.status}`);
  return res.json();
}

// ── CACHE ─────────────────────────────────────────────────────────────────────
// Simple in-memory cache keyed by param string, expires after 5 min
const _cache = new Map();
async function cachedFetch(params) {
  const key = JSON.stringify(params);
  const hit = _cache.get(key);
  if (hit && Date.now() - hit.ts < 300_000) return hit.data;
  const data = await apiFetch(params);
  _cache.set(key, { ts: Date.now(), data });
  return data;
}

// ── INTENT PARSER ────────────────────────────────────────────────────────────
// Pure function — no side effects, returns a typed intent object

const COUNTRY_ALIASES = {
  "dr congo":"COD","congo":"COD","drc":"COD",
  "central african republic":"CAF","car":"CAF",
  "south sudan":"SSD",
  "burkina faso":"BFA",
  "us":"USA","united states":"USA","america":"USA",
  "uk":"GBR","britain":"GBR","england":"GBR",
  "iran":"IRN","persia":"IRN",
  "myanmar":"MMR","burma":"MMR",
  "uae":"ARE","emirates":"ARE",
  "nk":"PRK","north korea":"PRK",
  "sk":"KOR","south korea":"KOR",
};

function resolveCountryName(raw) {
  if (!raw) return null;
  const lower = raw.toLowerCase().trim();
  if (COUNTRY_ALIASES[lower]) return COUNTRY_ALIASES[lower];
  return lower; // pass through to ?q= fuzzy search
}

const REGION_MAP = {
  africa:["africa","african"],
  asia:["asia","asian","southeast asia","south asia"],
  europe:["europe","european"],
  middleeast:["middle east","middleeast","mena","arab","gulf"],
  americas:["america","americas","latin america","latam","caribbean","south america"],
};

function detectRegion(text) {
  const lower = text.toLowerCase();
  for (const [region, aliases] of Object.entries(REGION_MAP)) {
    if (aliases.some(a => lower.includes(a))) return region;
  }
  return null;
}

const DIM_ALIASES = {
  food:["food","hunger","famine","starvation","ipc","nutrition"],
  displacement:["displacement","displaced","refugee","refugees","idp","idps","homeless"],
  health:["health","disease","outbreak","epidemic","cholera","ebola","malaria","medical"],
  conflict:["conflict","war","fighting","combat","battle","violence","armed"],
  economic:["economic","economy","gdp","poverty","financial"],
  climate:["climate","heat","flood","drought","weather","temperature"],
};

function detectDimension(text) {
  const lower = text.toLowerCase();
  for (const [dim, words] of Object.entries(DIM_ALIASES)) {
    if (words.some(w => lower.includes(w))) return dim;
  }
  return null;
}

function parseIntent(raw) {
  const t = raw.trim();
  const l = t.toLowerCase();

  // ── Compare: "compare X and Y" / "X vs Y" ─────────────────────────────
  const cmpMatch =
    l.match(/compare\s+(.+?)\s+(?:and|vs?\.?|versus)\s+(.+)/i) ||
    l.match(/(.+?)\s+(?:vs?\.?|versus)\s+(.+)/i);
  if (cmpMatch) {
    return { type:"compare", a:resolveCountryName(cmpMatch[1].trim()), b:resolveCountryName(cmpMatch[2].trim()) };
  }

  // ── Why not highest/lowest ─────────────────────────────────────────────
  const whyHighest = l.match(/why\s+(?:is\s+)?(.+?)\s+not\s+(?:the\s+)?highest/i);
  if (whyHighest) return { type:"why_not_highest", country:resolveCountryName(whyHighest[1].trim()) };

  const whyLowest  = l.match(/why\s+(?:is\s+)?(.+?)\s+not\s+(?:the\s+)?lowest/i);
  if (whyLowest)  return { type:"why_not_lowest",  country:resolveCountryName(whyLowest[1].trim()) };

  // ── Why is X higher/worse than Y ──────────────────────────────────────
  const whyHigher = l.match(/why\s+(?:is\s+)?(.+?)\s+(?:higher|worse|more severe)\s+than\s+(.+)/i);
  if (whyHigher) return { type:"compare", a:resolveCountryName(whyHigher[1].trim()), b:resolveCountryName(whyHigher[2].trim()) };

  // ── Top N ─────────────────────────────────────────────────────────────
  const topNMatch = l.match(/top\s+(\d+)/i);
  if (topNMatch) return { type:"top_n", n:Math.min(20, Math.max(1, parseInt(topNMatch[1]))) };

  // ── Worst [dimension] crisis ───────────────────────────────────────────
  const worstMatch = l.match(/worst\s+(.+?)(?:\s+crisis|\s+situation)?$/i);
  if (worstMatch) {
    const dim = detectDimension(worstMatch[1]);
    if (dim) return { type:"worst_dimension", dim };
  }

  // ── What is improving / escalating ────────────────────────────────────
  if (/\b(improv|getting better|going down)\w*/.test(l)) return { type:"trend_filter", trend:"improving" };
  if (/\b(escalat|worsening|getting worse|going up)\w*/.test(l)) return { type:"trend_filter", trend:"escalating" };

  // ── Threshold query: "above 70" / "over 80" / "at 75 or more" ─────────
  const threshMatch = l.match(/(?:above|over|at|score[sd]?\s+(?:of|above|over|at)?)\s*(\d{2,3})/i);
  if (threshMatch) return { type:"threshold", value:parseInt(threshMatch[1]) };

  // ── Region ────────────────────────────────────────────────────────────
  const region = detectRegion(l);
  if (region && l.split(" ").length <= 4) return { type:"region", region };

  // ── Alert set (informational only — no server-side persistence) ────────
  const alertMatch = l.match(/(?:alert|notify|tell)\s+me\s+(?:if|when)\s+(.+?)\s+(?:hits?|reaches?|gets? to)\s+(\d+)/i);
  if (alertMatch) return { type:"alert_request", country:resolveCountryName(alertMatch[1].trim()), threshold:parseInt(alertMatch[2]) };

  // ── "What is X like?" / "Situation in X" ──────────────────────────────
  const situationMatch =
    l.match(/(?:situation|status|update|whats? happening|how bad|how is|tell me about|what about)\s+(?:in\s+)?(.+)/i) ||
    l.match(/(?:is\s+)?(.+?)\s+(?:ok|okay|safe|fine|bad|terrible|dire)\??$/i);
  if (situationMatch) return { type:"country", country:resolveCountryName(situationMatch[1].trim()) };

  // ── Plain country name (fallback) ─────────────────────────────────────
  return { type:"country", country:resolveCountryName(t) };
}

// ── RESPONSE BUILDERS ────────────────────────────────────────────────────────
// Each returns an HTML string for rendering inside a .bubble

function renderDims(dimensions, highlight = null) {
  const order = ["conflict","displacement","food","health","economic","climate","access","political"];
  const rows  = order.map(k => {
    const d   = dimensions[k];
    if (!d) return "";
    const val  = d.value;
    const col  = dimColor(val);
    const isHL = highlight && k === highlight;
    const ctx  = d.context ? `<span class="dim-ctx">${escHtml(d.context)}</span>` : "";
    return `<div class="dim-row" style="${isHL ? "background:rgba(77,171,247,.06);border-radius:6px;padding:2px 4px;margin:-2px -4px;" : ""}">
      <div class="dim-label" style="${isHL ? "color:var(--cyan2);font-weight:700;" : ""}">${escHtml(d.label)}</div>
      <div class="dim-track"><div class="dim-fill" style="width:${val}%;background:${col}"></div></div>
      <div class="dim-val" style="color:${col}">${val}</div>
      ${ctx}
    </div>`;
  });
  return `<div class="dims">${rows.join("")}</div>`;
}

function renderEvidence(ev) {
  if (!ev) return "";
  const items = [];

  if (ev.earthquake) {
    items.push({ icon:"🌍", text:`M${ev.earthquake.magnitude.toFixed(1)} earthquake — ${escHtml(ev.earthquake.location)}`, src:"USGS" });
  }
  if (ev.food_security) {
    const pop = ev.food_security.population_affected > 0
      ? ` — ${(ev.food_security.population_affected/1e6).toFixed(1)}M people` : "";
    items.push({ icon:"🍚", text:`IPC Phase ${ev.food_security.phase} food insecurity${pop}`, src:"IPC" });
  }
  if (ev.disease_outbreaks?.length) {
    ev.disease_outbreaks.slice(0,3).forEach(ob => {
      const cases = ob.cases > 0 ? `, ${ob.cases.toLocaleString()}+ cases` : "";
      items.push({ icon:"🦠", text:`${escHtml(ob.disease)} — ${ob.severity} severity${cases}`, src:"WHO" });
    });
  }
  if (ev.displacement) {
    const total = (ev.displacement.total / 1e6).toFixed(1);
    const parts = [];
    if (ev.displacement.refugees > 0)      parts.push(`${(ev.displacement.refugees/1e6).toFixed(1)}M refugees`);
    if (ev.displacement.idps > 0)          parts.push(`${(ev.displacement.idps/1e6).toFixed(1)}M IDPs`);
    if (ev.displacement.asylum_seekers > 0) parts.push(`${(ev.displacement.asylum_seekers/1e6).toFixed(1)}M asylum-seekers`);
    items.push({ icon:"🚶", text:`${total}M displaced (${parts.join(", ")})`, src:"UNHCR" });
  }
  if (ev.heat) {
    const label = ev.heat.max_temp_c >= 42 ? "extreme heatwave" : ev.heat.max_temp_c >= 38 ? "severe heat" : "significant heat";
    items.push({ icon:"🥵", text:`${ev.heat.max_temp_c}°C — ${label}`, src:"Open-Meteo" });
  }

  if (!items.length) return "";
  return `<div class="evidence">${items.map(i =>
    `<div class="ev-item">
      <div class="ev-icon">${i.icon}</div>
      <div class="ev-text">${i.text} <span class="ev-source">${i.src}</span></div>
    </div>`
  ).join("")}</div>`;
}

function renderTrend(trend) {
  const { delta_7d, direction, forecast_7d, escalating } = trend;
  const sign   = delta_7d > 0 ? "+" : "";
  const cls    = direction === "escalating" ? "trend-up" : direction === "improving" ? "trend-down" : "trend-flat";
  const arrow  = direction === "escalating" ? "↑" : direction === "improving" ? "↓" : "→";
  return `<div class="trend-row">
    <span class="trend-dir ${cls}">${arrow} ${escHtml(direction.charAt(0).toUpperCase()+direction.slice(1))}</span>
    <span style="font-size:.75rem;color:var(--text3);">${sign}${delta_7d} pts in 7 days</span>
  </div>
  <div class="forecast-row">
    <span>📊 7-day forecast: <strong>${forecast_7d}/100</strong></span>
    ${escalating ? `<span style="color:var(--red);font-size:.72rem;">⚠ escalating</span>` : ""}
  </div>`;
}

function renderSpillover(spillover) {
  if (!spillover?.from?.length) return "";
  const nb = spillover.from.map(f => `${f.name} (${f.score})`).join(", ");
  return `<div class="spill-row">🌐 Regional pressure from ${escHtml(nb)} → +${spillover.value} pts</div>`;
}

function renderRecommendation(rec) {
  if (!rec) return "";
  const icons = { IMMEDIATE:"🔴", URGENT:"🟠", HIGH:"🟡", MONITOR:"🟢", WATCH:"🔵" };
  return `<div class="rec-box rec-${rec.tier}">
    <div class="rec-icon">${icons[rec.tier] || "ℹ️"}</div>
    <div class="rec-text">${escHtml(rec.text)}</div>
  </div>`;
}

function renderAudit(audit) {
  if (!audit?.adjustments?.length) return "";
  const items = audit.adjustments.map(a =>
    `<div class="audit-item">
      <span class="audit-src">${escHtml(a.source)}</span>
      <span class="audit-delta">+${a.delta}</span>
      <span>${escHtml(a.reason)}</span>
    </div>`
  ).join("");
  return `<span class="section-label">Score adjustments from live data</span>
    <div class="audit-list">${items}</div>
    <div style="font-size:.72rem;color:var(--text3);margin-top:.3rem;">
      Prior: ${audit.prior_score} → Live boost: +${audit.live_boost} → Spillover: +${audit.spillover} → <strong style="color:var(--text2);">Final: ${audit.final_score}</strong>
    </div>`;
}

function renderCountryCard(story, opts = {}) {
  const { showAudit = false, highlightDim = null } = opts;
  const col  = scoreColor(story.score);
  const sevClass = `sev sev-${story.severity}`;

  return `
    <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:.6rem;">
      <span style="font-size:1.6rem;">${story.flag}</span>
      <div>
        <div style="font-size:1.1rem;font-weight:800;line-height:1;">${escHtml(story.name)}</div>
        <div class="rank-chip" style="margin-top:.2rem;">
          #${story.rank} of ${story.total_countries} &nbsp;·&nbsp; top ${story.percentile}%
        </div>
      </div>
      <div style="margin-left:auto;text-align:right;">
        <div class="score-hero" style="color:${col}">${story.score}<span class="denom">/100</span></div>
        <span class="${sevClass}">${story.severity}</span>
      </div>
    </div>

    <span class="section-label">Key drivers</span>
    ${renderDims(story.dimensions, highlightDim)}

    <span class="section-label">Trend</span>
    ${renderTrend(story.trend)}

    <span class="section-label">Live evidence</span>
    ${renderEvidence(story.live_evidence) || '<span style="color:var(--text3);font-size:.78rem;">No live event signals at this time.</span>'}

    ${story.spillover?.value > 0 ? `<div class="divider"></div>${renderSpillover(story.spillover)}` : ""}
    ${story.anomaly?.z_score >= 1.5 ? `<div style="font-size:.75rem;color:var(--orange);margin:.3rem 0;">⚠️ Statistical anomaly (z=${story.anomaly.z_score}) — unusual deviation from 28-day baseline.</div>` : ""}

    <div class="divider"></div>
    ${renderRecommendation(story.recommendation)}

    ${showAudit ? `<div class="divider"></div>${renderAudit(story.score_audit)}` : ""}

    <div style="font-size:.65rem;color:var(--text3);margin-top:.5rem;font-family:monospace;">
      ${story.crisis_types?.map(c => `${c.icon} ${c.label}`).join("  ·  ") || ""}
    </div>
  `;
}

function renderRankList(countries, limit = 20, clickable = true) {
  return `<div class="rank-list">
    ${countries.slice(0, limit).map(c => {
      const col = scoreColor(c.score);
      return `<div class="rank-item" data-country="${escAttr(c.name)}" ${clickable?"style='cursor:pointer;'":""}>
        <div class="rank-num">#${c.rank}</div>
        <div class="rank-flag">${c.flag}</div>
        <div class="rank-name">${escHtml(c.name)}</div>
        <div class="rank-bar"><div class="rank-fill" style="width:${c.score}%;background:${col}"></div></div>
        <div class="rank-score" style="color:${col}">${c.score}</div>
        <span class="sev sev-${c.severity}" style="font-size:.58rem;">${c.severity}</span>
      </div>`;
    }).join("")}
  </div>`;
}

function renderComparisonTable(comparison, countries) {
  if (!comparison || countries.length < 2) return "";
  const [a, b] = countries;

  const dimOrder = ["conflict","displacement","food","health","economic","climate"];
  const rows = dimOrder.map(k => {
    const av = a.dimensions?.[k]?.value ?? 0;
    const bv = b.dimensions?.[k]?.value ?? 0;
    const label = a.dimensions?.[k]?.label ?? k;
    const aWins = av > bv;
    return `<tr>
      <td>${escHtml(label)}</td>
      <td class="${aWins?"winner":"loser"}">${av}${aWins?` <span style="color:var(--cyan2);font-size:.65rem;">▲</span>`:""}</td>
      <td class="${!aWins?"winner":"loser"}">${bv}${!aWins?` <span style="color:var(--cyan2);font-size:.65rem;">▲</span>`:""}</td>
    </tr>`;
  }).join("");

  return `<table class="comp-table">
    <thead>
      <tr>
        <th>Metric</th>
        <th>${a.flag} ${escHtml(a.name)}</th>
        <th>${b.flag} ${escHtml(b.name)}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Score</strong></td>
        <td class="${a.score>=b.score?"winner":"loser"}" style="font-weight:700">${a.score} <span class="sev sev-${a.severity}" style="font-size:.55rem">${a.severity}</span></td>
        <td class="${b.score>a.score?"winner":"loser"}" style="font-weight:700">${b.score} <span class="sev sev-${b.severity}" style="font-size:.55rem">${b.severity}</span></td>
      </tr>
      <tr>
        <td>Rank</td>
        <td class="${a.rank<=b.rank?"winner":"loser"}">#${a.rank}</td>
        <td class="${b.rank<a.rank?"winner":"loser"}">#${b.rank}</td>
      </tr>
      ${rows}
      <tr>
        <td>Trend (7d)</td>
        <td style="color:${a.trend?.delta_7d>0?"var(--red)":"var(--green)"}">${a.trend?.delta_7d>0?"+":""}${a.trend?.delta_7d}</td>
        <td style="color:${b.trend?.delta_7d>0?"var(--red)":"var(--green)"}">${b.trend?.delta_7d>0?"+":""}${b.trend?.delta_7d}</td>
      </tr>
      <tr>
        <td>Forecast</td>
        <td>${a.trend?.forecast_7d}/100</td>
        <td>${b.trend?.forecast_7d}/100</td>
      </tr>
    </tbody>
  </table>
  <div style="margin-top:.5rem;padding:.5rem .6rem;background:rgba(77,171,247,.05);border:1px solid var(--border);border-radius:var(--r-sm);font-size:.78rem;color:var(--text2);">
    <strong>Verdict:</strong> ${escHtml(comparison.verdict)}
  </div>`;
}

// ── RESPONSE HANDLERS ─────────────────────────────────────────────────────────
// One async function per intent type

async function handleCountry(country) {
  const data = await cachedFetch({ q: country });
  const s = data.top_story;
  if (!s) throw new Error(`No data for "${country}"`);
  return renderCountryCard(s, { showAudit: true });
}

async function handleTopN(n) {
  const data = await cachedFetch({ top: n });
  const countries = data.countries || (data.top_story ? [data.top_story] : []);
  if (!countries.length) throw new Error("Could not fetch rankings");

  const header = `<div style="margin-bottom:.6rem;font-size:.82rem;color:var(--text2);">
    Top ${n} countries by urgency score — live data
  </div>`;
  return header + renderRankList(countries, n, true);
}

async function handleCompare(a, b) {
  const [dataA, dataB] = await Promise.all([
    cachedFetch({ q: a }),
    cachedFetch({ q: b }),
  ]);
  const sA = dataA.top_story, sB = dataB.top_story;
  if (!sA || !sB) throw new Error("Could not find one or both countries");

  // Fetch comparison payload from API (iso=A,B)
  let comparison = null;
  try {
    const cmpData = await cachedFetch({ iso: `${sA.iso},${sB.iso}` });
    comparison = cmpData.comparison;
  } catch {}

  const header = `<div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.7rem;flex-wrap:wrap;">
    <span style="font-size:1.3rem;font-weight:800;">${sA.flag} ${escHtml(sA.name)}</span>
    <span style="color:var(--text3);font-weight:300;font-size:1.1rem;">vs</span>
    <span style="font-size:1.3rem;font-weight:800;">${sB.flag} ${escHtml(sB.name)}</span>
  </div>`;

  return header + renderComparisonTable(comparison, [sA, sB]) + `
    <div class="divider"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:.5rem;">
      <div>
        <span class="section-label">${sA.flag} ${escHtml(sA.name)} — Live evidence</span>
        ${renderEvidence(sA.live_evidence) || '<span style="font-size:.72rem;color:var(--text3);">None</span>'}
      </div>
      <div>
        <span class="section-label">${sB.flag} ${escHtml(sB.name)} — Live evidence</span>
        ${renderEvidence(sB.live_evidence) || '<span style="font-size:.72rem;color:var(--text3);">None</span>'}
      </div>
    </div>`;
}

async function handleWhyNotHighest(country) {
  const [targetData, topData] = await Promise.all([
    cachedFetch({ q: country }),
    cachedFetch({ top: 1 }),
  ]);
  const target  = targetData.top_story;
  const highest = topData.top_story;
  if (!target || !highest) throw new Error("Could not fetch data");

  if (target.iso === highest.iso) {
    return `${target.flag} <strong>${escHtml(target.name)}</strong> IS the highest — currently #${target.rank} at ${target.score}/100 (${target.severity}).`;
  }

  const gap = highest.score - target.score;
  const lines = [`<div style="margin-bottom:.6rem;font-size:.9rem;">
    <strong>${escHtml(target.flag)} ${escHtml(target.name)} (${target.score})</strong> ranks #${target.rank}
    vs <strong>${highest.flag} ${escHtml(highest.name)} (${highest.score})</strong> at #${highest.rank}.
    Gap: <strong style="color:var(--orange);">+${gap} pts</strong> in ${highest.name}'s favour.
  </div>`];

  const dims = ["conflict","displacement","food","health"];
  const advantages = dims.filter(k => {
    const hv = highest.dimensions?.[k]?.value ?? 0;
    const tv = target.dimensions?.[k]?.value  ?? 0;
    return hv - tv >= 8;
  });

  if (advantages.length) {
    lines.push(`<span class="section-label">Where ${escHtml(highest.name)} leads</span>`);
    lines.push(`<div class="dims">`);
    for (const k of advantages) {
      const hv = highest.dimensions[k].value, tv = target.dimensions[k]?.value ?? 0;
      const col = dimColor(hv);
      lines.push(`<div class="dim-row">
        <div class="dim-label" style="color:var(--text2)">${escHtml(highest.dimensions[k].label)}</div>
        <div class="dim-track"><div class="dim-fill" style="width:${hv}%;background:${col}"></div></div>
        <div class="dim-val" style="color:${col}">${hv}</div>
        <div class="dim-ctx" style="color:var(--orange);">+${hv-tv} vs ${escHtml(target.name)}</div>
      </div>`);
    }
    lines.push(`</div>`);
  }

  lines.push(`<div class="divider"></div>`);
  lines.push(`<span class="section-label">${escHtml(highest.name)} live signals not matched by ${escHtml(target.name)}</span>`);

  const higherEv = [], notInTarget = [];
  if (highest.live_evidence?.displacement && (!target.live_evidence?.displacement ||
      target.live_evidence.displacement.total < highest.live_evidence.displacement.total)) {
    const hm = (highest.live_evidence.displacement.total/1e6).toFixed(1);
    const tm = target.live_evidence?.displacement ? (target.live_evidence.displacement.total/1e6).toFixed(1) : "0.0";
    higherEv.push(`🚶 Displacement: ${hm}M vs ${tm}M (UNHCR)`);
  }
  if (highest.live_evidence?.food_security) {
    const hp = highest.live_evidence.food_security.phase;
    const tp = target.live_evidence?.food_security?.phase ?? 0;
    if (hp > tp) higherEv.push(`🍚 IPC Phase ${hp} vs Phase ${tp || "N/A"}`);
  }
  if (highest.live_evidence?.disease_outbreaks?.length && !target.live_evidence?.disease_outbreaks?.length) {
    notInTarget.push(`🦠 ${highest.live_evidence.disease_outbreaks[0].disease} outbreak (${highest.live_evidence.disease_outbreaks[0].severity})`);
  }

  const allEv = [...higherEv, ...notInTarget];
  if (allEv.length) {
    lines.push(`<div class="evidence">${allEv.map(e =>
      `<div class="ev-item"><div class="ev-text">${e}</div></div>`
    ).join("")}</div>`);
  } else {
    lines.push(`<div style="font-size:.78rem;color:var(--text3);">Scores are close — ${highest.name} has a consistent marginal advantage across dimensions.</div>`);
  }

  lines.push(`<div class="divider"></div>`);
  lines.push(`<div style="font-size:.78rem;color:var(--text2);">
    ${escHtml(target.name)} would need to gain <strong style="color:var(--orange);">${gap} points</strong> to tie for highest.
    At current trajectory (${target.trend?.direction}), that would take ${estimateDays(target.trend?.slope ?? 0, gap)}.
  </div>`);

  return lines.join("");
}

async function handleWhyNotLowest(country) {
  const [targetData, allData] = await Promise.all([
    cachedFetch({ q: country }),
    cachedFetch({ top: 20 }),
  ]);
  const target  = targetData.top_story;
  const countries = allData.countries || [];
  if (!target || !countries.length) throw new Error("Could not fetch data");

  const lowest = countries[countries.length - 1];
  if (target.iso === lowest.iso) {
    return `${target.flag} <strong>${escHtml(target.name)}</strong> IS among the lowest tracked — #${target.rank} at ${target.score}/100.`;
  }

  const gap = target.score - lowest.score;
  const lines = [`<div style="margin-bottom:.6rem;font-size:.9rem;">
    <strong>${target.flag} ${escHtml(target.name)} (${target.score})</strong> ranks #${target.rank}
    vs the lowest shown: <strong>${lowest.flag} ${escHtml(lowest.name)} (${lowest.score})</strong>.
    Gap: <strong style="color:var(--orange);">+${gap} pts</strong> above lowest.
  </div>`];

  lines.push(`<span class="section-label">What keeps ${escHtml(target.name)} elevated</span>`);
  const ev = renderEvidence(target.live_evidence);
  lines.push(ev || `<div style="font-size:.78rem;color:var(--text3);">No active live event signals, but prior indicators remain elevated.</div>`);

  lines.push(`<div class="divider"></div>`);
  lines.push(`<span class="section-label">Key dimensions above the lowest</span>`);
  lines.push(`<div class="dims">`);
  for (const { k } of [{ k:"conflict"},{k:"displacement"},{k:"food"},{k:"health"}]) {
    const tv = target.dimensions?.[k]?.value ?? 0;
    const lv = lowest.dimensions?.[k]?.value  ?? 0;
    if (tv - lv < 3) continue;
    const col = dimColor(tv);
    const label = target.dimensions[k]?.label ?? k;
    lines.push(`<div class="dim-row">
      <div class="dim-label">${escHtml(label)}</div>
      <div class="dim-track"><div class="dim-fill" style="width:${tv}%;background:${col}"></div></div>
      <div class="dim-val" style="color:${col}">${tv}</div>
      <div class="dim-ctx" style="color:var(--orange);">+${tv-lv} vs ${escHtml(lowest.name)}</div>
    </div>`);
  }
  lines.push(`</div>`);

  return lines.join("");
}

async function handleRegion(region) {
  const data = await cachedFetch({ region });
  const countries = data.countries || [];
  if (!countries.length) throw new Error(`No data for region: ${region}`);
  const label = region.charAt(0).toUpperCase() + region.slice(1);
  return `<div style="margin-bottom:.5rem;font-size:.82rem;color:var(--text2);">
    ${countries.length} countries tracked in <strong>${label}</strong>
  </div>` + renderRankList(countries, 20, true);
}

async function handleThreshold(value) {
  const data = await cachedFetch({ threshold: value });
  const countries = data.countries || (data.top_story ? [data.top_story] : []);
  if (!countries.length) return `No countries currently at or above score ${value}.`;
  return `<div style="margin-bottom:.5rem;font-size:.82rem;color:var(--text2);">
    ${countries.length} ${countries.length === 1 ? "country" : "countries"} scoring ≥${value}
  </div>` + renderRankList(countries, 20, true);
}

async function handleTrendFilter(trend) {
  const data = await cachedFetch({ top: 20 });
  const countries = (data.countries || []).filter(c => c.trend?.direction === trend);
  if (!countries.length) return `No countries currently ${trend} in the top 20.`;
  const label = trend === "escalating" ? "📈 Escalating" : "📉 Improving";
  return `<div style="margin-bottom:.5rem;font-size:.82rem;color:var(--text2);">
    ${countries.length} countries ${trend} (of top 20 tracked)
  </div>` + renderRankList(countries, 20, true);
}

async function handleWorstDimension(dim) {
  const data = await cachedFetch({ top: 20 });
  const countries = data.countries || [];
  const sorted = [...countries].sort((a,b) =>
    (b.dimensions?.[dim]?.value ?? 0) - (a.dimensions?.[dim]?.value ?? 0)
  );
  const label = sorted[0]?.dimensions?.[dim]?.label ?? dim;
  return `<div style="margin-bottom:.5rem;font-size:.82rem;color:var(--text2);">
    Worst <strong>${escHtml(label)}</strong> crises — sorted by ${dim} dimension score
  </div>
  <div class="dims" style="margin-bottom:.6rem;">
    ${sorted.slice(0,10).map(c => {
      const val = c.dimensions?.[dim]?.value ?? 0;
      const col = dimColor(val);
      return `<div class="dim-row" style="cursor:pointer;" data-country="${escAttr(c.name)}">
        <div class="dim-label" style="width:120px;color:var(--text);">${c.flag} ${escHtml(c.name)}</div>
        <div class="dim-track"><div class="dim-fill" style="width:${val}%;background:${col}"></div></div>
        <div class="dim-val" style="color:${col}">${val}</div>
        <div class="dim-ctx">${c.dimensions?.[dim]?.context ? escHtml(c.dimensions[dim].context) : ""}</div>
      </div>`;
    }).join("")}
  </div>`;
}

function handleAlertRequest(country, threshold, currentScore) {
  const gap = threshold - currentScore;
  const days = gap > 0 ? `~${Math.max(1, Math.round(gap / 0.5))} days at current pace` : "already reached";
  return `<div style="display:flex;align-items:flex-start;gap:.6rem;padding:.5rem .7rem;background:rgba(77,171,247,.05);border:1px solid var(--border2);border-radius:var(--r-sm);">
    <span style="font-size:1rem;">🔔</span>
    <div style="font-size:.82rem;color:var(--text2);">
      <strong>Alert noted.</strong> ${escHtml(country)} is currently at ${currentScore}/100.
      It would need to gain <strong>${Math.max(0,gap)} more points</strong> to hit ${threshold}.
      Estimated: <strong>${days}</strong>.
      <br><span style="color:var(--text3);font-size:.7rem;">Note: CRYS doesn't persist alerts server-side. Bookmark this page and check back.</span>
    </div>
  </div>`;
}

// ── UTILS ─────────────────────────────────────────────────────────────────────
function escHtml(s) {
  return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}
function escAttr(s) {
  return String(s ?? "").replace(/"/g,"&quot;");
}
function estimateDays(slope, gap) {
  if (!slope || slope <= 0) return "unknown timeline";
  const days = Math.ceil(gap / slope);
  return days > 365 ? "over a year" : days > 90 ? `~${Math.round(days/30)} months` : `~${days} days`;
}

// ── DOM HELPERS ───────────────────────────────────────────────────────────────
const msgsEl  = document.getElementById("msgs");
const chatEl  = document.getElementById("chat");
const inpEl   = document.getElementById("inp");

let typingEl  = null;

function scrollBottom() {
  chatEl.scrollTop = chatEl.scrollHeight;
}

function addMsg(html, isUser, meta = "") {
  const div = document.createElement("div");
  div.className = `msg msg-${isUser ? "user" : "crys"}`;
  div.innerHTML = `<div class="bubble">${isUser ? escHtml(html) : html}</div>
    ${meta ? `<div class="msg-meta">${meta}</div>` : ""}`;
  msgsEl.appendChild(div);
  scrollBottom();

  // Attach click handlers for rank-item and dim-row drill-down
  div.querySelectorAll("[data-country]").forEach(el => {
    el.style.cursor = "pointer";
    el.addEventListener("click", () => {
      const country = el.getAttribute("data-country");
      if (country) submitQuery(country);
    });
  });

  return div;
}

function showTyping() {
  if (typingEl) return;
  const div = document.createElement("div");
  div.className = "msg msg-crys";
  div.id = "typing";
  div.innerHTML = `<div class="typing"><span></span><span></span><span></span></div>`;
  msgsEl.appendChild(div);
  typingEl = div;
  scrollBottom();
}

function hideTyping() {
  if (typingEl) { typingEl.remove(); typingEl = null; }
}

// ── ORCHESTRATOR ──────────────────────────────────────────────────────────────
async function submitQuery(raw) {
  const q = raw.trim();
  if (!q) return;

  addMsg(q, true, "you");
  inpEl.value = "";
  inpEl.focus();
  showTyping();

  const t0 = Date.now();
  let html  = "";
  let meta  = "";

  try {
    const intent = parseIntent(q);

    switch (intent.type) {
      case "country": {
        html = await handleCountry(intent.country);
        meta = "CRYS · live data";
        break;
      }
      case "compare": {
        html = await handleCompare(intent.a, intent.b);
        meta = "CRYS · comparison";
        break;
      }
      case "why_not_highest": {
        html = await handleWhyNotHighest(intent.country);
        meta = "CRYS · analysis";
        break;
      }
      case "why_not_lowest": {
        html = await handleWhyNotLowest(intent.country);
        meta = "CRYS · analysis";
        break;
      }
      case "top_n": {
        html = await handleTopN(intent.n);
        meta = `CRYS · top ${intent.n}`;
        break;
      }
      case "region": {
        html = await handleRegion(intent.region);
        meta = `CRYS · ${intent.region}`;
        break;
      }
      case "threshold": {
        html = await handleThreshold(intent.value);
        meta = `CRYS · score ≥${intent.value}`;
        break;
      }
      case "trend_filter": {
        html = await handleTrendFilter(intent.trend);
        meta = `CRYS · ${intent.trend}`;
        break;
      }
      case "worst_dimension": {
        html = await handleWorstDimension(intent.dim);
        meta = `CRYS · ${intent.dim}`;
        break;
      }
      case "alert_request": {
        // Fetch current score first, then render
        const d = await cachedFetch({ q: intent.country });
        const s = d.top_story;
        html = handleAlertRequest(s?.name ?? intent.country, intent.threshold, s?.score ?? 0);
        meta = "CRYS · alert";
        break;
      }
      default: {
        html = await handleCountry(intent.country);
        meta = "CRYS · live data";
      }
    }

    meta += ` · ${Date.now() - t0}ms`;

  } catch (err) {
    console.error(err);
    html = `<span style="color:var(--red);">❌ ${escHtml(err.message)}</span>
      <br><span style="font-size:.75rem;color:var(--text3);">Try: "Somalia", "compare Sudan and Yemen", "top 5", "Africa ranked", "worst food crisis".</span>`;
    meta = "error";
  }

  hideTyping();
  addMsg(html, false, meta);
}

// ── INPUT WIRING ──────────────────────────────────────────────────────────────
document.getElementById("sendBtn").addEventListener("click", () => submitQuery(inpEl.value));
inpEl.addEventListener("keypress", e => { if (e.key === "Enter") submitQuery(inpEl.value); });
document.querySelectorAll(".chip").forEach(chip => {
  chip.addEventListener("click", () => submitQuery(chip.getAttribute("data-q")));
});
</script>
